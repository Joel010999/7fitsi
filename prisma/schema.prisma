generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id @default(cuid())
  name          String
  price         Float
  originalPrice Float?
  imageUrl      String?
  category      String
  subCategory   String?
  colors        String?  // Ej: "Negro, Azul"
  sizes         String?  // Ej: "S, M, L"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GiftCard {
  id            String   @id @default(cuid())
  amount        Float
  code          String   @unique
  recipientName String?
  message       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
