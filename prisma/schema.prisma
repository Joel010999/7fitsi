generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id            String   @id @default(cuid())
  name          String
  price         Float
  originalPrice Float?
  listPrice     Float?
  imageUrl      String?
  images        String   @default("[]")
  category      String
  subCategory   String?
  colors        String?  // Ej: "Negro, Azul"
  sizes         String?  // Ej: "S, M, L"
  description   String?
  stock         Int      @default(0)
  variants      String   @default("[]")
  categoryOrder Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GiftCard {
  id            String   @id @default(cuid())
  amount        Float
  code          String   @unique
  recipientName String?
  message       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model SaleRecord {
  id          String   @id @default(cuid())
  productId   String
  productName String
  size        String
  color       String
  quantity    Int
  price       Float
  priceType   String   @default("Efectivo")
  totalPrice  Float
  createdAt   DateTime @default(now())
}
